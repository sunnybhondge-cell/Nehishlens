{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev-server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "check-api (deployed mock)",
      "type": "shell",
      "command": "node scripts/check-api.mjs",
      "problemMatcher": []
    }
  ]
}
