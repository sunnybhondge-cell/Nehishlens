# NehishLens frontend — environment configuration
# Copy this file to .env.development (for `npm run dev`) or .env.production
# (for `npm run build`) and edit the values. Vite only exposes variables
# prefixed with VITE_ to client code — see src/api/config.ts.
#
# Nothing in this app should ever hard-code an API URL. If you find a raw
# "https://mock-api-nehishlens.aminobots.com" string anywhere outside this
# file and src/api/config.ts, that's a bug — file it.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Base URL for all versioned API calls (everything except /health, /docs,
# /api-console, /collection.json, which live at the root — see VITE_API_ROOT).
# Per NehishLensAPIWiringGuide.docx this is:
VITE_API_BASE_URL=https://mock-api-nehishlens.aminobots.com/api/v1

# Root of the service, used only for the unversioned routes above.
VITE_API_ROOT=https://mock-api-nehishlens.aminobots.com

# ---------------------------------------------------------------------------
# Optional — sensible defaults are baked into src/api/config.ts if omitted
# ---------------------------------------------------------------------------

# Lens the UI renders before anyone signs in (never sent to the API — the
# lens comes from the sign-in token). One of: ops | eng | assure | exec
VITE_DEFAULT_LENS=ops

# Request timeout in milliseconds before a call is treated as failed.
VITE_API_TIMEOUT_MS=10000

# Force every GET to carry this X-Mock-State header (see "Driving the nine
# states" in the wiring guide: loading | empty | partial | error | denied |
# zero | stale | confirmed | default). Leave blank in normal use — this is
# for demoing/testing one state across the whole app without editing URLs.
VITE_FORCE_MOCK_STATE=

# Legacy flag. This build ships no fixtures and is live-data-only: a failed
# call always surfaces the server's own error (QueryState -> ApiErrorBanner),
# never placeholder data. Kept at false; changing it has no effect.
VITE_ALLOW_FIXTURE_FALLBACK=false

# When true, logs every request/response (method, path, lens, status,
# duration) to the console. Useful in VS Code's integrated terminal while
# running `npm run dev`.
VITE_DEBUG_API_LOGGING=false

# Dev-only capture. MUST stay false for client / production builds — and in a
# build it is inert anyway (the writing middleware is dev-server only).
VITE_API_LOG=false

# Dev-only affordances (seeded mock accounts on sign-in, Observe-incident form).
# Must stay false for any client / production deploy.
VITE_DEV_TOOLS=false
